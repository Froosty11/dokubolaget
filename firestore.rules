rules_version = '2';

// Firestore security rules for Dokubolaget.
// Deploy: firebase deploy --only firestore:rules
// (or paste into Firebase console -> Firestore -> Rules).
//
// The board seeder and admin scripts use the Admin SDK, which bypasses these
// rules. Everything below is what a browser or phone may do.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Public names are shown on the leaderboard, so never an email address.
    function validDisplayName(name) {
      return name is string && name.matches('^[^@<>]{2,24}$');
    }

    // boards/{YYYY-MM-DD}, keyed by UTC date. Readable once that day has
    // started, so tomorrow's board can't be read a day early.
    function boardDateHasStarted(dateKey) {
      let parts = dateKey.split('-');
      return dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && timestamp.date(int(parts[0]), int(parts[1]), int(parts[2])) <= request.time;
    }

    match /boards/{dateKey} {
      allow get: if boardDateHasStarted(dateKey);
      allow list, write: if false;
    }

    // Public leaderboard profile. Players may only set their own display name.
    // Scores and streaks are not client-writable, so they can't be forged from
    // the browser; they are only written server-side.
    match /users/{uid} {
      allow get: if true;
      allow list: if request.query.limit <= 50;
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName'])
        && validDisplayName(request.resource.data.displayName);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && validDisplayName(request.resource.data.displayName);
      allow delete: if false;

      // Private per-player state: only the owner can see or change it.
      match /private/{docId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && docId == 'profile'
          && request.resource.data.keys().hasOnly(['gameCells', 'currentCell', 'email', 'theme']);
      }
    }

    // Cached public Systembolaget API key, shared so every client doesn't
    // have to scrape it. Signed-in players may refresh it, but only with a
    // plausible key, and the app re-scrapes if a cached key stops working.
    match /appConfig/dokubolagetSystembolagetApi {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.keys().hasOnly(['apiKey', 'source', 'updatedAt'])
        && request.resource.data.apiKey is string
        && request.resource.data.apiKey.matches('^[A-Za-z0-9]{16,64}$')
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 32
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
