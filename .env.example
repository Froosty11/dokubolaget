# Copy to .env and fill in. Everything is optional; with an empty file the
# container serves the app and plays bundled fallback boards.

# --- Daily board seeding (server-side) ---------------------------------------
# Firebase service account JSON, on ONE line. Enables the nightly pipeline that
# writes boards/{YYYY-MM-DD} to Firestore. Generate it in the Firebase console:
# Project settings -> Service accounts -> Generate new private key.
# Only the Firestore upload step of the pipeline receives it. Give the account
# the narrowest role that can write the boards collection, and keep this file
# readable only by you (chmod 600 .env).
FIREBASE_SERVICE_ACCOUNT_KEY=

# SEED_ENABLED=false        # turn the pipeline off even if the key is set
# SEED_ON_START=false       # don't seed today+tomorrow when the container boots
# SEED_HOUR_UTC=0           # daily run time, default 00:05 UTC
# SEED_MINUTE_UTC=5
# SEED_ATTEMPTS=3000        # generator effort per board

# --- Web build (build-time; requires `docker compose build`) -----------------
# Leave blank to use the Firebase project baked into src/firebaseConfig.ts.
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Network -----------------------------------------------------------------
# Host port to expose (container always listens on 8080).
# PORT=8080
# Address the port binds to on the host. Defaults to 127.0.0.1 so only a reverse
# proxy on the same machine can reach it. Use 0.0.0.0 to expose it directly.
# BIND_ADDRESS=127.0.0.1

# Set when a reverse proxy sits in front, so the Systembolaget proxy's rate
# limit counts real client addresses (from X-Forwarded-For) instead of treating
# every visitor as the reverse proxy. Leave unset when exposed directly.
TRUST_PROXY=true
# PROXY_RATE_LIMIT=120      # proxy requests per client per minute
