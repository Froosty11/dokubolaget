# Copy to .env and fill in. Everything is optional; with an empty file the
# container serves the app and plays bundled fallback boards.

# --- Daily board seeding (server-side) ---------------------------------------
# Firebase service account JSON, on ONE line. Enables the nightly pipeline that
# writes boards/{YYYY-MM-DD} to Firestore. Generate it in the Firebase console:
# Project settings -> Service accounts -> Generate new private key.
FIREBASE_SERVICE_ACCOUNT_KEY=

# SEED_ENABLED=false        # turn the pipeline off even if the key is set
# SEED_ON_START=false       # don't seed today+tomorrow when the container boots
# SEED_HOUR_UTC=0           # daily run time, default 00:05 UTC
# SEED_MINUTE_UTC=5
# SEED_ATTEMPTS=3000        # generator effort per board

# --- Web build (build-time; requires `docker compose build`) -----------------
# Leave blank to use the Firebase project baked into src/firebaseConfig.ts.
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=

# Host port to expose (container always listens on 8080).
# PORT=8080
