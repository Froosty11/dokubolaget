# Copy to .env and fill in. Everything is optional; with an empty file the
# container serves the app and plays bundled fallback boards.

# --- Daily board seeding -------------------------------------------------------
# The nightly pipeline downloads the product catalog, generates tomorrow's
# board and stores it in the app database. No credentials needed.
# SEED_ENABLED=false        # turn the pipeline off (bundled boards are used)
# SEED_ON_START=false       # don't seed today+tomorrow when the container boots
# SEED_HOUR_UTC=0           # daily run time, default 00:05 UTC
# SEED_MINUTE_UTC=5
# SEED_ATTEMPTS=3000        # generator effort per board

# --- Accounts ------------------------------------------------------------------
# Password reset emails. Without these, reset links are written to the
# container log (docker logs dokubolaget) so an admin can pass them on.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Dokubolaget <no-reply@dokubolaget.se>"
# The site's public address. Required for password reset links (they are never
# built from request headers) and the only origin allowed to change data.
PUBLIC_URL=https://dokubolaget.se

# --- Network -----------------------------------------------------------------
# Host port to expose (container always listens on 8080).
# PORT=8080
# Address the port binds to on the host. Defaults to 127.0.0.1 so only a reverse
# proxy on the same machine can reach it. Use 0.0.0.0 to expose it directly.
# BIND_ADDRESS=127.0.0.1

# Only when a reverse proxy (e.g. Caddy) sits in front: rate limits then use the
# client address the proxy appends to X-Forwarded-For, and HTTPS is detected.
# Remove it if the container is exposed directly, or clients could spoof it.
TRUST_PROXY=true
# PROXY_RATE_LIMIT=120      # proxy requests per client per minute
